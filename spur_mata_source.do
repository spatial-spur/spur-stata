real matrix sv2_get_sigma_lbm_dm(real matrix distmat)
{
// Double-demeaned LBM covariance matrix:
// sigma_lbm = 0.5 * (d1*1' + 1*d1' - distmat)
// Since M1 * 1 = 0, origin terms vanish under double demeaning:
// sv2_demeanmat(sigma_lbm) == -0.5 * sv2_demeanmat(distmat)

	return(-0.5 * sv2_demeanmat(distmat))
}
end


