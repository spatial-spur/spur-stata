real matrix sv2_demeanmat(real matrix mat)
// demeans matrix without mutating input argument
{
	real matrix res
	res = mat :- (rowsum(mat) / cols(mat))
	res = res :- (colsum(res) / rows(mat))
	return(res)
}

end


